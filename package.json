{
  "name": "svg-lint",
  "version": "1.0.0",
  "description": "SVG compatibility checker for iOS/Xcode asset catalogs",
  "type": "module",
  "bin": {
    "svg-lint": "./dist/bin/svg-lint.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx bin/svg-lint.ts gui",
    "dev": "tsx watch bin/svg-lint.ts gui",
    "lint": "tsx bin/svg-lint.ts",
    "preview": "tsx bin/svg-lint.ts preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@generac/prism-design-system": "^15.3.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@xmldom/xmldom": "^0.9.5",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.2",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
